  },
  "components": {
    "schemas": {
      "AscendRequest": {
        "properties": {
          "enrichment_func": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enrichment Func",
            "description": "L0\u2192L1 enrichment name; omit to use parent-data 'source_expansion' / defaults."
          },
          "dimensions": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dimensions",
            "description": "L1\u2192L2 and L2\u2192L3 dimension names; omit for registry defaults."
          },
          "relationships": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Relationships",
            "description": "L2\u2192L3 relationship names."
          },
          "source_column": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Column",
            "description": "L2\u2192L3 column to derive from (defaults to 'value')."
          }
        },
        "additionalProperties": true,
        "type": "object",
        "title": "AscendRequest",
        "description": "`increase_complexity(target = current+1)`. Never reaches L4.\n\nField names match the engine's ascent adapter kwargs (`_ascent_params`);\nall are optional because each edge falls back to registry defaults (and L0\u2192L1\nreconstructs from the persisted parent vector \u2014 the spec-015 T007 fix)."
      },
      "BranchFromRequest": {
        "properties": {
          "node_id": {
            "type": "string",
            "title": "Node Id"
          },
          "action": {
            "type": "string",
            "title": "Action",
            "description": "'descend' | 'ascend' \u2014 the transition to run off the node."
          },
          "params": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Params",
            "description": "Per-edge params (same shape as descend/ascend)."
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "node_id",
          "action"
        ],
        "title": "BranchFromRequest"
      },
      "CreateSessionRequest": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source",
            "description": "Dataset source, e.g. 'demo:school_scores' | 'demo:ademe' | 'demo:energy'.",
            "default": "demo:school_scores",
            "examples": [
              "demo:school_scores"
            ]
          }
        },
        "type": "object",
        "title": "CreateSessionRequest",
        "description": "Create a session from a named demo dataset (or, later, an upload)."
      },
      "DepStatus": {
        "properties": {
          "configured": {
            "type": "boolean",
            "title": "Configured"
          },
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "configured",
          "ok"
        ],
        "title": "DepStatus"
      },
      "DescendRequest": {
        "properties": {
          "builder": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Builder",
            "description": "L4\u2192L3 graph builder name, e.g. 'rows_as_nodes' | 'bipartite'."
          },
          "config": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Config",
            "description": "Builder kwargs (e.g. {'id_column': 'id'})."
          },
          "domains": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Domains",
            "description": "L3\u2192L2 category labels, e.g. ['high score','low score']."
          },
          "use_semantic": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Use Semantic",
            "description": "L3\u2192L2 use embedding similarity for matching."
          },
          "threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Threshold",
            "description": "L3\u2192L2 semantic similarity threshold (0\u20131)."
          },
          "column": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Column",
            "description": "L2\u2192L1 column to keep."
          },
          "filter_query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filter Query",
            "description": "L2\u2192L1 optional pandas query filter."
          },
          "aggregation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aggregation",
            "description": "L1\u2192L0 aggregation: 'mean' | 'sum' | 'count' | ..."
          }
        },
        "additionalProperties": true,
        "type": "object",
        "title": "DescendRequest",
        "description": "`reduce_complexity(target = current-1)`. Fields are per-edge; only the\nrelevant ones apply at each level (extras pass through to the engine)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "'ok' if the app is up (deps may degrade gracefully)."
          },
          "deps": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DepStatus"
            },
            "type": "object",
            "title": "Deps"
          }
        },
        "type": "object",
        "required": [
          "status",
          "deps"
        ],
        "title": "HealthResponse"
      },
      "ImportRequest": {
        "properties": {
          "schema_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Schema Version"
          },
          "metadata": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metadata"
          },
          "tree": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tree"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "title": "ImportRequest",
        "description": "A full-fidelity `session_export` record to rehydrate into a new session."
      },
      "MutationCount": {
        "properties": {
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "count"
        ],
        "title": "MutationCount",
        "description": "Return shape for prune/archive \u2014 how many nodes were affected."
      },
      "NodeIdRequest": {
        "properties": {
          "node_id": {
