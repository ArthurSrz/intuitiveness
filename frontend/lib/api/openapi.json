{
  "openapi": "3.1.0",
  "info": {
    "title": "Intuitiveness API",
    "summary": "REST surface over the descent/ascent abstraction-level engine.",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
