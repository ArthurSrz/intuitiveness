    },
    "/sessions/{session_id}/descend": {
      "post": {
        "tags": [
          "transitions"
        ],
        "summary": "Descend",
        "description": "Reduce complexity one level (L4\u2192L3\u2192\u2026\u2192L0).",
        "operationId": "descend_sessions__session_id__descend_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
