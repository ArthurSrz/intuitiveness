    "/sessions/{session_id}/time-travel": {
      "post": {
        "tags": [
          "tree"
        ],
        "summary": "Time Travel",
        "description": "Move the current pointer to an existing node (no new transition).",
        "operationId": "time_travel_sessions__session_id__time_travel_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
