# Backend configuration (spec 017). All values come from the environment /
# Railway secrets — there is NO code difference between local and Railway (FR-006).
# Copy to `.env` for local runs (uvicorn loads the process env).

# --- CORS: the frontend origin(s) allowed to call this API ------------------
# Comma-separated. "*" (default) allows any origin — fine for local dev.
ALLOWED_ORIGINS=http://localhost:3000

# --- Durable session store (PostgreSQL) ------------------------------------
# Railway injects DATABASE_URL automatically when you reference the Postgres
# service. Locally, leave it UNSET to persist sessions to ~/.intuitiveness/sessions/.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Embeddings (OpenRouter / OpenAI-compatible) — optional ----------------
# Needed only for semantic L3<->L2 domain matching; degrades gracefully if unset.
# EMBEDDING_API_KEY=sk-or-...
# EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_MODEL=baai/bge-m3

# --- Graph database (Memgraph / Neo4j) — optional --------------------------
# MEMGRAPH_URI=bolt://memgraph.railway.internal:7687
# MEMGRAPH_USERNAME=
# MEMGRAPH_PASSWORD=
