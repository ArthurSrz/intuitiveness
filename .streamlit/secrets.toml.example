# Streamlit Secrets Configuration
# Copy this file to .streamlit/secrets.toml and fill in your actual credentials
# DO NOT commit secrets.toml to version control!

# TabPFN API Configuration
# Get your token from: https://tabpfn.ai
TABPFN_ACCESS_TOKEN = "your_tabpfn_token_here"

# Alternative key name (both work)
# TABPFN_TOKEN = "your_tabpfn_token_here"

# HuggingFace API Configuration (required for semantic search bar)
# Get your token from: https://huggingface.co/settings/tokens
# Used by the NL query engine to call SmolLM3-3B for natural language search
HF_TOKEN = "your_huggingface_token_here"

# Graph database (Memgraph on Railway, Bolt protocol)
# The graph feature (L4->L3 knowledge graph + agent) is OPTIONAL; if these are
# unset the app runs without it. Use bolt+s:// when TLS is terminated by the
# Railway TCP proxy, otherwise bolt://. Leave user/password empty only if the
# Memgraph instance runs without auth (not recommended for a public proxy).
MEMGRAPH_URI = "bolt+s://<railway-host>:<proxy-port>"
MEMGRAPH_USER = "neo4j"
MEMGRAPH_PASSWORD = "your_memgraph_password_here"
MEMGRAPH_DATABASE = "memgraph"
# NEO4J_URI / NEO4J_USER / NEO4J_PASSWORD / NEO4J_DATABASE are accepted as aliases.

# Note: For local development, you can also use .env file
# For deployed apps on Streamlit Cloud, use the Streamlit Cloud secrets UI
